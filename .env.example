# ---- required ----
MDM_DOMAIN=mdm.thesouledstore.com
MDM_PUBLIC_URL=https://mdm.thesouledstore.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# generate with:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
MDM_SECRET_KEY=change-me-to-a-long-random-string

# ---- first super admin (created on first start if none exists) ----
MDM_SUPERADMIN_EMAIL=haris.khalifa@thesouledstore.com
MDM_SUPERADMIN_NAME=Haris Khalifa
# Leave blank to auto-generate; it's written to /data/initial_superadmin.txt in the mdm container.
MDM_SUPERADMIN_PASSWORD=

# ---- optional ----
MDM_APP_NAME=TSS MDM
MDM_ACCESS_TOKEN_MINUTES=480
MDM_OFFLINE_AFTER_MINUTES=15
MDM_CHECKIN_INTERVAL_SECONDS=300
MDM_MAX_FAILED_LOGINS=5
MDM_LOCKOUT_MINUTES=15
